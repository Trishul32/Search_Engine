# ---------- database (SQLite default; PostgreSQL in production) ----------
# DATABASE_URL=postgresql+psycopg2://raguser:ragpass@localhost:5432/arxiv_rag

# ---------- embeddings ----------
EMBEDDING_BACKEND=sentence-transformers      # or: hash (no-torch fallback)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5      # higher quality, slower

# ---------- retrieval ----------
FUSION_METHOD=rrf                            # rrf | weighted
DYNAMIC_ALPHA=true
RETRIEVAL_TOP_K=30
RERANK_TOP_K=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CORRECTIVE_RETRIEVAL=true

# ---------- on-demand full-text indexing & chunking ----------
# Search NEVER downloads PDFs; papers are downloaded/parsed/embedded only
# when selected for QA. LAZY_LOAD_TOP_N bounds how many papers Multi-Paper
# QA auto-selects (and therefore indexes) when none are chosen explicitly.
LAZY_LOAD_TOP_N=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------- LLM ----------
# auto = pick the strongest available backend at startup:
#   1. openai-compatible endpoint (Ollama/vLLM/LM Studio) if reachable
#   2. local HuggingFace model if torch+transformers installed
#   3. extractive grounded synthesis (always available)
LLM_BACKEND=auto
# With Ollama running locally, auto selects this endpoint before Hugging Face.
# LLM_BACKEND=openai-compatible
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct           # local HF backend model
LLM_API_MODEL=llama3.1:8b                    # served model name (Ollama etc.)
LLM_API_BASE=http://localhost:11434/v1       # Ollama default
LLM_MAX_NEW_TOKENS=700
LLM_TEMPERATURE=0.2
# Post-validate generated answers: strip citations to non-existent sources
# and regenerate extractively when an answer carries no valid citation.
LLM_GROUNDING_CHECK=true
