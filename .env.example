# ---------- database (SQLite default; PostgreSQL in production) ----------
# DATABASE_URL=postgresql+psycopg2://raguser:ragpass@localhost:5432/arxiv_rag

# ---------- embeddings ----------
EMBEDDING_BACKEND=sentence-transformers      # or: hash (no-torch fallback)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5      # higher quality, slower

# ---------- retrieval ----------
FUSION_METHOD=rrf                            # rrf | weighted
DYNAMIC_ALPHA=true
RETRIEVAL_TOP_K=30
RERANK_TOP_K=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CORRECTIVE_RETRIEVAL=true

# ---------- lazy loading & chunking ----------
LAZY_LOAD_TOP_N=3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------- LLM ----------
LLM_BACKEND=extractive                       # extractive | hf | openai-compatible
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# For Ollama:   LLM_BACKEND=openai-compatible  LLM_MODEL=llama3.1  LLM_API_BASE=http://localhost:11434/v1
